# --- database ---
DATABASE_URL="file:./prisma/dev.db"

# --- payments ---
# stripe = real Stripe test mode · sandbox = local simulated authorization
PAYMENTS_MODE="sandbox"
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- admin (Basic Auth on /admin) ---
ADMIN_USER="admin"
ADMIN_PASS="change-me-min-8-chars"

# --- optional canonical origin; leave empty to derive from request headers ---
NEXT_PUBLIC_SITE_URL=""
